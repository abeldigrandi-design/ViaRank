generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum ActivityType {
  RIDE
  RUN
  WALK
  HIKE
  SWIM
  KAYAK
  ROW
  SAIL
  WINDSURF
  WHEELCHAIR
}

enum Sex {
  MALE
  FEMALE
}

enum ActivitySource {
  STRAVA
  GOOGLE_HEALTH
  RIDE_WITH_GPS
  IGPSPORT
  VIARANK
}

model User {
  id            String  @id @default(cuid())
  stravaId      String? @unique
  firstName     String
  lastName      String
  sex           Sex?
  email         String? @unique
  emailVerified Boolean @default(false)
  pinHash       String?

  profilePicture String?
  customProfilePicture String?
  birthDay       Int?
  birthMonth     Int?
  city           String?
  country        String?

  accessToken  String?
  refreshToken String?
  expiresAt    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(USER)
  isActive Boolean @default(true)
  activities                   Activity[]
  groupMemberships             GroupMember[]
  administeredGroups           SportGroup[]                 @relation("GroupAdministrator")
  sessions                     UserSession[]
  travelCompanyAdministrations TravelCompanyAdministrator[]
  travelReservations           TravelReservation[]
  travelTripTeamMemberships    TravelTripTeamMember[]
  rankingPenaltiesApplied      GroupActivityPenalty[]       @relation("PenaltyAppliedBy")
  varResolutionsApplied        GroupActivityVarResolution[] @relation("VarResolvedBy")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PendingEmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  sex       Sex?
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id            String         @id @default(cuid())
  externalId    String?
  source        ActivitySource @default(STRAVA)
  stravaId      String?        @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  type          ActivityType
  name          String
  distance      Float
  movingTime    Int
  elevationGain Float
  averageSpeed  Float?
  calories      Int?
  startDate     DateTime
  createdAt     DateTime       @default(now())

  groupActivityReviews   GroupActivityReview[]
  groupActivityPenalties GroupActivityPenalty[]
  varResolutionsAsFirst  GroupActivityVarResolution[] @relation("VarFirstActivity")
  varResolutionsAsSecond GroupActivityVarResolution[] @relation("VarSecondActivity")

  @@unique([source, externalId])
}

model SportGroup {
  id         String          @id @default(cuid())
  name       String
  sport      ActivityType
  joinCode   String          @unique
  visibility GroupVisibility @default(PUBLIC)

  activityControlSpeed   Float?
  activityControlMinutes Int?

  administratorId String
  administrator   User   @relation("GroupAdministrator", fields: [administratorId], references: [id])

  members           GroupMember[]
  events            GroupEvent[]
  eventTemplates    GroupEventTemplate[]
  activityReviews   GroupActivityReview[]
  activityPenalties GroupActivityPenalty[]
  varResolutions    GroupActivityVarResolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sport])
  @@index([administratorId])
}

model GroupMember {
  id      String @id @default(cuid())
  userId  String
  groupId String

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  joinedAt        DateTime @default(now())
  canCreateEvents Boolean  @default(false)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}


model GroupEventTemplate {
  id      String     @id @default(cuid())
  groupId String
  group   SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title           String
  meetingPlace    String?
  destination     String?
  departureTime   String?
  estimatedReturn String?
  plannedSpeed    String?
  rules           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}

model GroupEvent {
  id      String     @id @default(cuid())
  groupId String
  group   SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title           String
  eventDate       DateTime
  departureTime   String
  meetingPlace    String
  destination     String?
  estimatedReturn String?
  plannedSpeed    String?
  rules           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([eventDate])
}

model GroupActivityPenalty {
  id String @id @default(cuid())

  groupId    String
  activityId String
  appliedBy  String

  group    SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  reviewer User       @relation("PenaltyAppliedBy", fields: [appliedBy], references: [id])

  reason                 String
  originalDistanceMeters Float
  rankingDistanceMeters  Float  @default(10)

  appliedAt  DateTime  @default(now())
  revertedAt DateTime?

  @@unique([groupId, activityId])
  @@index([groupId])
  @@index([activityId])
  @@index([appliedBy])
}

model GroupActivityVarResolution {
  id String @id @default(cuid())

  groupId          String
  firstActivityId  String
  secondActivityId String
  resolvedBy       String

  group          SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  firstActivity  Activity   @relation("VarFirstActivity", fields: [firstActivityId], references: [id], onDelete: Cascade)
  secondActivity Activity   @relation("VarSecondActivity", fields: [secondActivityId], references: [id], onDelete: Cascade)
  reviewer       User       @relation("VarResolvedBy", fields: [resolvedBy], references: [id])

  resolvedAt DateTime @default(now())

  @@unique([groupId, firstActivityId, secondActivityId])
  @@index([groupId])
  @@index([firstActivityId])
  @@index([secondActivityId])
  @@index([resolvedBy])
}

model GroupActivityReview {
  id         String @id @default(cuid())
  groupId    String
  activityId String

  group    SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  referenceSpeed       Float
  maximumMinutes       Int
  maxContinuousSeconds Int
  needsReview          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, activityId])
  @@index([groupId])
  @@index([activityId])
}

enum TravelCompanyAccessStatus {
  PENDING
  TRIAL
  ACTIVE
  EXEMPT
  SUSPENDED
  EXPIRED
}

enum TravelCompanyApplicationStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

model TravelCompany {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  whatsapp    String?
  email       String?

  accessStatus     TravelCompanyAccessStatus @default(PENDING)
  activationCode   String?                   @unique
  activationUsedAt DateTime?
  accessStartsAt   DateTime?
  accessExpiresAt  DateTime?
  planName         String?

  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  trialMonthsGranted   Int?
  trialGrantedAt       DateTime?
  trialGrantedByUserId String?

  administrators TravelCompanyAdministrator[]
  trips          TravelTrip[]
  application    TravelCompanyApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model TravelCompanyAdministrator {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  isPrimary Boolean @default(false)

  company TravelCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

enum TravelTripStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

enum TravelTripTeamRole {
  ORGANIZER
  COLLABORATOR
}

model TravelTrip {
  id        String @id @default(cuid())
  companyId String

  company     TravelCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  destination String
  description String?

  status       TravelTripStatus @default(DRAFT)
  isFeatured   Boolean          @default(false)
  displayOrder Int              @default(0)

  startDate DateTime?
  endDate   DateTime?
  days      Int?
  nights    Int?

  totalDistanceKm Float?
  elevationGain   Float?
  difficulty      String?

  price                  Float?
  totalCapacity          Int?
  externalReservedPlaces Int    @default(0)

  showDates      Boolean @default(true)
  showDistance   Boolean @default(true)
  showElevation  Boolean @default(true)
  showDifficulty Boolean @default(true)
  showPrice      Boolean @default(true)
  showCapacity   Boolean @default(true)

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  modules        TravelTripModule[]
  activities     TravelTripActivity[]
  accommodations TravelAccommodation[]
  meals          TravelTripMeal[]
  transport      TravelTripTransport?
  transfers      TravelTripTransfer?

  insurance      TravelTripInsurance?
  equipment      TravelTripEquipment[]
  pricing        TravelTripPricing?
  reservations   TravelReservation[]
  teamMembers    TravelTripTeamMember[]

  @@index([companyId])
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
}

model TravelTripTeamMember {
  id     String @id @default(cuid())
  tripId String
  userId String

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TravelTripTeamRole

  // Permisos operativos para COLLABORATOR.
  // Los ORGANIZER tienen acceso operativo completo al viaje.
  canManageParticipants  Boolean @default(false)
  canManageActivities    Boolean @default(false)
  canManageAccommodation Boolean @default(false)
  canManageFood          Boolean @default(false)
  canManageTransport     Boolean @default(false)
  canManageInsurance     Boolean @default(false)

  canManageEquipment     Boolean @default(false)
  canManageNotices       Boolean @default(false)
  canContactParticipants Boolean @default(false)

  // Informacion economica bloqueada por defecto.
  canViewFinancials   Boolean @default(false)
  canManageFinancials Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([role])
}

model TravelCompanyApplication {
  id String @id @default(cuid())

  companyName String
  contactName String
  email       String
  phone       String?
  whatsapp    String?

  city        String?
  country     String?
  website     String?
  description String?

  status TravelCompanyApplicationStatus @default(PENDING)

  companyId String?        @unique
  company   TravelCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  adminNotes  String?
  contactedAt DateTime?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum TravelModuleType {
  ACCOMMODATION
  SPORTS_ACTIVITIES
  FOOD
  PASSENGER_TRANSPORT
  BICYCLE_TRANSPORT
  TRANSFERS
  INSURANCE
  EQUIPMENT_RENTAL
  RESERVATIONS
  PAYMENTS
  RULES_WAIVER
  VIARANK_GROUP
  OFFICIAL_NOTICES
  PARTICIPANT_CONTACT
}

enum TravelActivityCategory {
  CYCLING
  HIKING
  WALKING
  RUNNING
  SWIMMING
  KAYAK
  ROWING
  SAILING
  COMPLEMENTARY
  OTHER
}

enum TravelActivityScheduleType {
  PROGRAMMED
  ALTERNATIVE
  WEATHER_DEPENDENT
}

enum TravelInclusionStatus {
  INCLUDED
  NOT_INCLUDED
  NOT_APPLICABLE
}

enum TravelMealType {
  BREAKFAST
  LUNCH
  PACKED_MEAL
  REFRESHMENT
  DINNER
  WELCOME_DINNER
}

model TravelTripModule {
  id        String           @id @default(cuid())
  tripId    String
  type      TravelModuleType
  isEnabled Boolean          @default(false)

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, type])
  @@index([tripId])
}

model TravelTripActivity {
  id     String @id @default(cuid())
  tripId String

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  category     TravelActivityCategory
  scheduleType TravelActivityScheduleType @default(PROGRAMMED)

  name        String
  description String?
  imageUrl    String?

  dayNumber    Int?
  activityDate DateTime?
  displayOrder Int       @default(0)

  distanceKm      Float?
  durationMinutes Int?
  activeMinutes   Int?
  elevationGain   Float?
  maxAltitude     Float?
  expectedPace    String?
  expectedSpeed   String?
  difficulty      String?
  terrain         String?
  departurePoint  String?
  arrivalPoint    String?

  guideEnabled          Boolean @default(false)
  closerEnabled         Boolean @default(false)
  radioCommunication    Boolean @default(false)
  supportVehicleEnabled Boolean @default(false)
  lightMechanicsEnabled Boolean @default(false)

  entranceStatus TravelInclusionStatus @default(NOT_APPLICABLE)
  transferStatus TravelInclusionStatus @default(NOT_APPLICABLE)

  notes String?

  requirements TravelActivityRequirement[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  meals        TravelTripMeal[]

  @@index([tripId])
  @@index([category])
  @@index([displayOrder])
}

model TravelActivityRequirement {
  id         String @id @default(cuid())
  activityId String

  activity TravelTripActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  name         String
  isMandatory  Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([activityId])
}

model TravelAccommodation {
  id     String @id @default(cuid())
  tripId String

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  type        String
  name        String
  location    String?
  description String?

  nights   Int?
  capacity Int?

  sharedAccommodationText String?

  privateOptionEnabled               Boolean @default(false)
  privateOptionPrice                 Float?
  privateOptionSubjectToAvailability Boolean @default(true)

  previousNightEnabled  Boolean @default(false)
  previousNightPrice    Float?
  followingNightEnabled Boolean @default(false)
  followingNightPrice   Float?

  features Json?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([displayOrder])
}

model TravelTripMeal {
  id         String  @id @default(cuid())
  tripId     String
  activityId String?

  trip     TravelTrip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity TravelTripActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  dayNumber Int?
  type      TravelMealType
  status    TravelInclusionStatus @default(NOT_APPLICABLE)

  restaurantName         String?
  restaurantAddress      String?
  approximateTime        String?
  reservationCoordinated Boolean @default(false)

  viaBreakEnabled Boolean @default(false)

  description  String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([activityId])
  @@index([dayNumber])
}

enum TravelReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TravelPassengerTransportChoice {
  ORGANIZER_TRANSPORT
  OWN_MEANS
}

enum TravelBicycleTransportChoice {
  ORGANIZER_TRANSPORT
  OWN_MEANS
  NOT_APPLICABLE
}

enum TravelPaymentStatus {
  PENDING
  REPORTED
  VERIFIED
  REJECTED
}

enum TravelPricingMode {
  FIXED
  FIXED_DEPOSIT_ADJUSTABLE_BALANCE
}

enum TravelReservationPaymentMode {
  FIXED_DEPOSIT
  PERCENTAGE_DEPOSIT
  FULL_PAYMENT
}

enum TravelExtraType {
  PRIVATE_ACCOMMODATION
  PREVIOUS_NIGHT
  FOLLOWING_NIGHT
  EQUIPMENT_RENTAL
  TRANSFER
  OTHER
}

model TravelTripTransfer {
  id     String @id @default(cuid())
  tripId String @unique

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  arrivalTransferEnabled  Boolean @default(false)
  arrivalTransferIncluded Boolean @default(false)
  arrivalTransferPrice    Float?
  arrivalPickupPoint      String?
  arrivalDestination      String?
  arrivalInstructions     String?

  departureTransferEnabled  Boolean @default(false)
  departureTransferIncluded Boolean @default(false)
  departureTransferPrice    Float?
  departurePickupPoint      String?
  departureDestination      String?
  departureInstructions     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelTripTransport {
  id     String @id @default(cuid())
  tripId String @unique

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  passengerTransportEnabled  Boolean @default(false)
  passengerTransportIncluded Boolean @default(false)
  passengerCapacity          Int?

  bicycleTransportEnabled  Boolean @default(false)
  bicycleTransportIncluded Boolean @default(false)
  bicycleCapacity          Int?
  bicycleTransportType     String?
  bicycleTransportPrice    Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelTripEquipment {
  id     String @id @default(cuid())
  tripId String

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name        String
  type        String?
  description String?

  quantityAvailable Int?
  price             Float?

  conditions String?
  notes      String?

  displayOrder Int     @default(0)
  enabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([enabled])
  @@index([displayOrder])
}
model TravelTripInsurance {
  id     String @id @default(cuid())
  tripId String @unique

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  enabled  Boolean @default(false)
  required Boolean @default(false)
  included Boolean @default(false)

  provider     String?
  coverageType String?
  coverage     String?

  price Float?

  validFrom  DateTime?
  validUntil DateTime?

  instructions String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TravelTripPricing {
  id     String @id @default(cuid())
  tripId String @unique

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  mode TravelPricingMode @default(FIXED)

  basePrice    Float?
  reservationPaymentMode TravelReservationPaymentMode?
  depositValue           Float?
  depositPercentage      Float?

  participantCancellationPolicy String?
  weatherPolicy                 String?
  companyCancellationPolicy     String?

  adjustmentMethod      String?
  adjustmentDescription String?

  versions TravelPricingVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelPricingVersion {
  id        String @id @default(cuid())
  pricingId String

  pricing TravelTripPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  version     Int
  termsText   String

  pricingMode TravelPricingMode
  basePrice   Float

  reservationPaymentMode TravelReservationPaymentMode?
  depositValue           Float?
  depositPercentage      Float?

  participantCancellationPolicy String?
  weatherPolicy                 String?
  companyCancellationPolicy     String?
  adjustmentMethod      String?
  adjustmentDescription String?
  effectiveAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([pricingId, version])
  @@index([pricingId])
}

model TravelReservation {
  id     String  @id @default(cuid())
  tripId String
  userId String?

  trip TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  status TravelReservationStatus @default(PENDING)

  firstName String
  lastName  String
  document  String?
  birthDate DateTime?
  phone     String?
  email     String?

  city    String?
  address String?

  healthCoverageName   String?
  healthCoverageNumber String?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  emergencyContactPhoneAlt     String?

  passengerTransportChoice TravelPassengerTransportChoice?
  bicycleTransportChoice   TravelBicycleTransportChoice?

  arrivalMode          String?
  arrivalDate          DateTime?
  arrivalApproxTime    String?
  arrivalPlace         String?
  arrivalCompany       String?
  arrivalServiceNumber String?
  arrivalNotes         String?

  departureMode          String?
  departureDate          DateTime?
  departureApproxTime    String?
  departurePlace         String?
  departureCompany       String?
  departureServiceNumber String?
  departureNotes         String?

  bicycleType         String?
  bicycleBrand        String?
  bicycleModel        String?
  bicycleColor        String?
  bicycleWheelSize    String?
  bicycleSerialNumber String?
  bicyclePhotoUrl     String?
  bicycleNotes        String?

  basePrice      Float?
  extrasTotal    Float  @default(0)
  totalPrice     Float?
  totalPaid      Float  @default(0)
  pendingBalance Float?
  reservationRequiredAmount Float?

  pricingTermsAcceptedAt DateTime?
  pricingTermsVersion    Int?
  confirmedAt                DateTime?

  waiverAcceptedAt DateTime?
  waiverVersion    Int?

  extras             TravelReservationExtra[]
  payments           TravelPayment[]
  balanceAdjustments TravelBalanceAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([userId])
  @@index([status])
  @@unique([tripId, userId])
}

model TravelReservationExtra {
  id            String @id @default(cuid())
  reservationId String

  reservation TravelReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  type        TravelExtraType
  sourceId    String?
  name        String
  description String?
  quantity    Int             @default(1)
  unitPrice   Float
  totalPrice  Float

  createdAt DateTime @default(now())

  @@index([reservationId])
  @@index([type, sourceId])
}

model TravelPayment {
  id            String @id @default(cuid())
  reservationId String

  reservation TravelReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  amount Float
  status TravelPaymentStatus @default(PENDING)

  receiptUrl String?
  reportedAt DateTime?
  verifiedAt DateTime?
  rejectedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([status])
}

model TravelBalanceAdjustment {
  id            String @id @default(cuid())
  reservationId String

  reservation TravelReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  previousBalance Float
  newBalance      Float
  reason          String

  createdAt DateTime @default(now())

  @@index([reservationId])
}
