generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum ActivityType {
  RIDE
  RUN
  WALK
  HIKE
  SWIM
  KAYAK
  ROW
  SAIL
  WINDSURF
  WHEELCHAIR
}
enum Sex {
  MALE
  FEMALE
}
enum ActivitySource {
  STRAVA
  GOOGLE_HEALTH
  RIDE_WITH_GPS
  IGPSPORT
}
model User {
  id                  String        @id @default(cuid())
  stravaId            String?       @unique
  firstName           String
  lastName            String
  sex                 Sex?
 email               String?       @unique
emailVerified              Boolean   @default(false)

profilePicture      String?
  city                String?
  country             String?

  accessToken         String?
  refreshToken        String?
  expiresAt           Int?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  role                UserRole      @default(USER)

  activities          Activity[]
  groupMemberships    GroupMember[]
  administeredGroups  SportGroup[]  @relation("GroupAdministrator")
sessions            UserSession[]
}
model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
model PendingEmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  sex       Sex?
 code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Activity {
  id            String       @id @default(cuid())
  externalId    String
source        ActivitySource @default(STRAVA)
stravaId      String?        @unique
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  type          ActivityType
  name          String
  distance      Float
  movingTime    Int
  elevationGain Float
  averageSpeed  Float?
  calories      Int?
  startDate     DateTime
  createdAt     DateTime     @default(now())
  @@unique([source, externalId])
}

model SportGroup {
  id              String        @id @default(cuid())
  name            String
  sport           ActivityType
  joinCode        String        @unique
  visibility      GroupVisibility @default(PUBLIC)

  administratorId String
  administrator   User          @relation("GroupAdministrator", fields: [administratorId], references: [id])

  members         GroupMember[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sport])
  @@index([administratorId])
}

model GroupMember {
  id        String     @id @default(cuid())
  userId    String
  groupId   String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     SportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  joinedAt  DateTime   @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

